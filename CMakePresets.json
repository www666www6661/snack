{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SNACK_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-clang-debug",
      "inherits": "base",
      "displayName": "Windows clang-cl Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clang-release",
      "inherits": "windows-clang-debug",
      "displayName": "Windows clang-cl Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-clang-debug",
      "inherits": "base",
      "displayName": "Linux Clang Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang-release",
      "inherits": "linux-clang-debug",
      "displayName": "Linux Clang Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-arm64-release",
      "inherits": "linux-clang-release",
      "displayName": "Linux ARM64 Clang Release",
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "aarch64"
      }
    },
    {
      "name": "coverage-linux",
      "inherits": "linux-clang-debug",
      "displayName": "Linux LLVM Coverage",
      "cacheVariables": {
        "SNACK_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "base",
      "displayName": "macOS Apple Clang Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-intel-release",
      "inherits": "macos-debug",
      "displayName": "macOS Intel Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "macos-arm64-release",
      "inherits": "macos-debug",
      "displayName": "macOS Apple Silicon Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-clang-debug", "configurePreset": "windows-clang-debug" },
    {
      "name": "windows-clang-release",
      "configurePreset": "windows-clang-release"
    },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-arm64-release", "configurePreset": "linux-arm64-release" },
    { "name": "coverage-linux", "configurePreset": "coverage-linux" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-intel-release", "configurePreset": "macos-intel-release" },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release" }
  ],
  "testPresets": [
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug",
      "output": { "outputOnFailure": true },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": { "outputOnFailure": true },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "output": { "outputOnFailure": true },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ]
}
